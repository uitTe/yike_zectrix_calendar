# 硬件参数与官方 Demo 保持一致：16 MB Flash / 8 MB Octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# zectrix_board 通过 esp_codec_dev 驱动板载 ES8311
CONFIG_CODEC_ES8311_SUPPORT=y

# 本机唯一可用的串口是芯片内置的 USB-Serial/JTAG（COM5），日志必须输出到它
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

CONFIG_COMPILER_CXX_EXCEPTIONS=n

# 每日唤醒要在主任务里完成 WiFi 连接，默认 3584 字节不够 esp_wifi_init 与事件回调使用。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
